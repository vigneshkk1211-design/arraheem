# ==========================================
# Hybrid WhatsApp AI Chatbot Configuration
# ==========================================

# Local Ollama AI Server Configuration
OLLAMA_URL=http://localhost:11434
MODEL_NAME=llama3.2
OLLAMA_TIMEOUT_MS=45000

# Business Information & Persona
BUSINESS_NAME=SmartAssist Solutions
SYSTEM_PROMPT="You are a helpful, professional, and polite customer support assistant for SmartAssist Solutions on WhatsApp. Keep your replies concise, friendly, and formatted clearly for mobile reading. If a user asks complex technical questions or explicitly requests a human agent, politely let them know they can type 'agent' or 'human' at any time to connect with our staff."

# Handover & Admin Notification Settings
# Optional: Set an admin phone number (with country code, digits only) to receive instant WhatsApp alerts when a customer requests a handover
# Example: ADMIN_PHONE=15551234567
ADMIN_PHONE=

# Whether to send an in-chat confirmation message when an admin toggles AI (!off / !on)
SEND_TOGGLE_FEEDBACK=true

# Session & Auth Settings
SESSION_PATH=./.wwebjs_auth
STATE_FILE_PATH=./chat_states.json

# Local Google Chrome Executable Path
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

